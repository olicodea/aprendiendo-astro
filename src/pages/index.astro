---
import SiteHeader from "@/components/SiteHeader.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import UserCard from "@/components/UserCard.astro";

const title = "Página principal";
const description = "Una larga y detallada descripción de mi página.";
const headerData = {
    title: "Aprendiendo Astro desde prop",
    description: "Primer día con Astro.",
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body>
        <SiteHeader {...headerData} />
        <SiteNav />

        <h2>{title}</h2>
        <UserCard name="ManzDev" image="manzdev.png">
            <slot name="header">
                <h1>UserCard</h1>
            </slot>
            <slot name="content">
                <h2>Information</h2>
                <p>...</p>
                <h2>Links</h2>
                <p>...</p>
            </slot>
            <slot name="footer">Tarjeta de usuario personalizada.</slot>
        </UserCard>
        <main>
            <p>Contenido de la página web en cuestión.</p>
        </main>

        <SiteFooter />
    </body>
</html>
