---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import CustomRating from "@/components/CustomRating.astro";
import ReactComponent from "@/components/ReactComponent.jsx";

const layoutData = {
    title: "Mi página principal",
    description: "Descripción larga y detallada de la página principal.",
}

const classList = ['success', 'danger'];
const isDanger = true;
---
<BaseLayout {...layoutData}>
  <SiteHeader />
  <SiteNav class="nav-bar" />

  <h2>{layoutData.title}</h2>

  <main class:list={classList}>
    <p class:list={{ red: isDanger }} > Contenido de la página web en cuestión.</p>
    <CustomRating value="3" />

    <ReactComponent title="Hello World Astro!" />

  </main>

  <SiteFooter  />
</BaseLayout>

